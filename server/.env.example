# Copia este archivo como `.env` (el servidor lo carga al arrancar si existe).

# Puerto HTTP/WebSocket. Render lo define automáticamente.
PORT=8080

# Orígenes que pueden abrir el WebSocket y usar la API (CORS), separados por comas,
# o * para cualquiera.
# Si no se define, se aceptan http://localhost:5173 y http://127.0.0.1:5173.
# En producción: la URL del cliente en Vercel, sin barra final.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL. Si no se define, los tableros se guardan en memoria y se pierden al
# reiniciar, y no hay cuentas (la API responde 503 y todos los tableros son públicos).
# Este valor corresponde al docker-compose.yml de la raíz del repo.
# En Render: la «Internal Database URL» de la base.
DATABASE_URL=postgres://pizarra:pizarra@localhost:5434/pizarra
