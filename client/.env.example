# URL del servidor WebSocket. Copia este archivo como `.env.local`.
# La API de cuentas usa el mismo servidor con http/https, así que solo hay que
# configurar esta variable.
# Si no se define, se usa ws://<host actual>:8080 (útil en desarrollo).
# En producción debe ser wss://, por ejemplo: wss://pizarra-server.onrender.com
VITE_WS_URL=ws://localhost:8080
